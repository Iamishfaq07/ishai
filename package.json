{
  "name": "orbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @orbit/web dev",
    "dev:desktop": "pnpm --filter @orbit/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": "7.1.6",
      "source-map-js": "1.2.2",
      "braces": "npm:@franciscosolis/braces@3.1.1",
      "zod": "4.6.7"
    }
  }
}
