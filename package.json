{
  "name": "orbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:web": "pnpm --filter @orbit/web dev",
    "dev:desktop": "pnpm --filter @orbit/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.9.0"
  }
}
