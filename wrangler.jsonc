// Cloudflare deploy config for the Orbit web app (a static SPA served from Cloudflare's edge).
// The build command (`pnpm --filter @orbit/web build`) emits apps/web/dist; `wrangler deploy`
// uploads that directory as static assets. The Worker runs first for every address except the built files below, and
// decides what each one is (apps/web/worker/seo.js, routes.js; DECISIONS D67): one of the app's pages gets index.html
// (so React Router works on refresh and deep links), anything else a real 404, never index.html with a 200.
{
  "name": "orbit",
  "compatibility_date": "2026-09-01",
  "main": "apps/web/worker/index.js",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    // A missing file is a 404 (the Worker serves index.html itself for the app's own pages), and an address is never
    // given a trailing slash: "/jobs/" is redirected to "/jobs", the one form search engines see.
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
    // The Worker first, everywhere but the built files that never need it (each request through it is billed):
    //   /api/* is proxied to the API (first-party session cookie — see apps/web/worker/index.js);
    //   the public pages people share get their own link previews and their built HTML (meta.js, prerendered.js);
    //   the question bank's guides (/companies, /roles) are built files it fetches from the assets as they are;
    //   every address gets its status code, redirects and robots headers (apps/web/worker/seo.js).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/mediapipe/*",
      "!/theme-init.js",
      "!/pcm16-worklet.js",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/icon-maskable-512.png",
      "!/og-image.jpg",
      "!/og/*",
      "!/fonts/*",
      "!/manifest.webmanifest"
    ]
  },
  // Pings the API's /health so a host that sleeps when idle never makes a visitor wait for its cold start
  // (apps/web/worker/index.js). Railway's service doesn't sleep; the ping is cheap insurance.
  "triggers": { "crons": ["*/10 * * * *"] },
  // The API on Railway (Singapore, next to Neon's aws-ap-southeast-1) behind its own name, so a host move is a DNS
  // change (DECISIONS D53). The old Render service is retired (D55).
  // Search engines' site-verification codes go here too, once the owner has them (docs/SEO.md):
  //   "GOOGLE_SITE_VERIFICATION", "BING_SITE_VERIFICATION", "YANDEX_VERIFICATION", "NAVER_SITE_VERIFICATION",
  //   "SEZNAM_VERIFICATION" (each the code alone, not the whole tag). AI_TRAINING_CRAWLERS: "allow" (the default) or
  //   "block" (DECISIONS D67).
  "vars": { "API_URL": "https://api.orbitanswer.com", "DEPLOYMENT_ENV": "production" },
  // Unconfigured previews fail closed. Provision independent staging resources before adding a URL.
  "previews": { "vars": { "API_URL": "", "DEPLOYMENT_ENV": "preview" } },
  "env": {
    "staging": {
      "name": "orbit-staging",
      "vars": { "API_URL": "", "DEPLOYMENT_ENV": "staging" },
      "triggers": { "crons": [] }
    }
  }
  // Production PROXY_SECRET = production ORBIT_PROXY_SECRET. Staging needs a distinct secret.
}
