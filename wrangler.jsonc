// Cloudflare deploy config for the Orbit web app (a static SPA served from Cloudflare's edge).
// The build command (`pnpm --filter @orbit/web build`) emits apps/web/dist; `wrangler deploy`
// uploads that directory as static assets. `single-page-application` routes unknown paths to
// index.html so client-side routing (React Router) works on refresh/deep links.
{
  "name": "orbit",
  "compatibility_date": "2026-09-01",
  "main": "apps/web/worker/index.js",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* is proxied to the API by the Worker (first-party session cookie — see apps/web/worker/index.js).
    // Run the Worker first there so the SPA fallback never answers an API call with index.html. The public pages
    // people share also go through it, for their own link previews (apps/web/worker/meta.js).
    "run_worker_first": ["/api", "/api/*", "/", "/resume-ai", "/jobs", "/warmup", "/contact"]
  },
  // Keep the Render free-tier API from sleeping (see apps/web/worker/index.js). One always-on free
  // service uses ~744 of Render's 750 free instance-hours a month, so keep it the only running free service.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Singapore (Render + Neon aws-ap-southeast-1): ~90 ms from India, vs ~280 ms to the old Ohio service.
  "vars": { "API_URL": "https://orbit-api-sg.onrender.com" }
  // Secret (not a var): `wrangler secret put PROXY_SECRET` with the API's ORBIT_PROXY_SECRET, so the API can trust
  // the client IP this Worker forwards (apps/web/worker/index.js).
}
