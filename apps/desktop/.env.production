# Production build config for the desktop app. Public only — no secrets.
# The API's own name, not a hosting provider's: when the API moves host, the DNS record follows it and installed apps
# (update checks included) keep working with no release (DECISIONS D53). 0.1.40 and older called the retired
# Render host directly (D55).
VITE_API_URL=https://api.orbitanswer.com
VITE_WEB_URL=https://orbitanswer.com
