# Production build config for the web app (Cloudflare). Public only — no secrets.
VITE_API_URL=https://orbit-api-5kcx.onrender.com
# HTTP calls go through the worker's same-origin proxy (apps/web/worker/index.js) so the session cookie is
# first-party; Safari on iOS blocks it cross-site. The WebSocket still uses VITE_API_URL.
VITE_API_PROXY_PATH=/api
