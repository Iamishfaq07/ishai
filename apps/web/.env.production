# Production build config for the web app (Cloudflare). Public only — no secrets.
# REST calls go through the Worker's same-origin /api proxy (apps/web/worker/index.js) so the session cookie is
# first-party and survives browsers that block third-party cookies (iOS Safari and every other iOS browser).
VITE_API_URL=/api
# Live-session WebSockets authenticate with a single-use ticket, not the cookie, so they connect to the API directly.
VITE_LIVE_URL=https://orbit-api-5kcx.onrender.com
