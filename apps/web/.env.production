# Production build config for the web app (Cloudflare). Public only — no secrets.
# REST calls go through the Worker's same-origin /api proxy (apps/web/worker/index.js) until the API says its cookies
# are shared with its own address; then most go straight there (VITE_API_DIRECT_URL, D80), which is the same site, so
# the session cookie stays first-party (iOS Safari and every other iOS browser block third-party cookies).
VITE_API_URL=/api
VITE_API_DIRECT_URL=https://api.orbitanswer.com
# Live-session WebSockets authenticate with a single-use ticket, not the cookie, so they connect to the API directly.
VITE_LIVE_URL=https://api.orbitanswer.com
# The Microsoft Store listing ("Orbit AI Career Assistant", 9NJ1ZXGTCZKL) is public: show Microsoft's badge and send
# Windows downloads there (docs/MICROSOFT_STORE.md). The direct installer stays as the alternative.
VITE_MS_STORE_LIVE=true
