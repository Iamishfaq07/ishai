# Cloudflare static-asset headers (Workers Static Assets reads this file from the build output).

# Every page: what the browser may load and do. Scripts come only from this site (no inline script: the theme
# bootstrap is /theme-init.js) and Cloudflare Turnstile; the API is same-origin (/api), live sessions use the API's
# WebSocket directly. Nobody can frame the app (clickjacking), and a leaked link carries no referrer.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://orbit-api-sg.onrender.com wss://orbit-api-sg.onrender.com https://orbit-api-5kcx.onrender.com wss://orbit-api-5kcx.onrender.com https://challenges.cloudflare.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self), display-capture=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Built files under /assets/ have a content hash in their name, so they never change: cache them for a year and
# skip the revalidation round trip on every visit. index.html keeps the default (always revalidated), so a deploy
# is picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
