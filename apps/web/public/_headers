# Cloudflare static-asset headers. The security headers (one CSP, HSTS, nosniff, DENY) are written by
# vite.config.ts at build time. A second copy here would be enforced as well, and the stricter of the two
# would block Razorpay.

# Built files under /assets/ have a content hash in their name, so they never change: cache them for a year and
# skip the revalidation round trip on every visit. index.html keeps the default (always revalidated), so a deploy
# is picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, the link-preview image and the camera coach's model keep their names across deploys, so they can't be
# immutable; a day (a week for the model) saves the revalidation round trip, and a stale copy is refreshed in the
# background. Pages keep the default (always revalidated).
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/mediapipe/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
