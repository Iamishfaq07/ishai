# Public config only — anything prefixed VITE_ is shipped to the browser. Never put API keys here.
VITE_API_URL=http://localhost:8000
# Optional: where Help and "Report this job" (Jobs AI) send people (lib/contact.ts). Without them Help links the
# contact page and Report offers copy and cybercrime.gov.in. WhatsApp: the number with its country code, digits only.
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_SUPPORT_WHATSAPP=919876543210
# Optional: the browser extension's store listing once it's published; /extension/connect links it ("Get the extension").
# VITE_EXTENSION_URL=https://chromewebstore.google.com/detail/<id>
