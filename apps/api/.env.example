# Copy to apps/api/.env. Every provider key is optional in development:
# missing keys fall back to mock providers (never faked as "real").

ORBIT_ENV=development
# Required in production and equal to the Cloudflare Worker secret PROXY_SECRET (32+ random characters).
# Empty in development/test uses a local-only default.
ORBIT_PROXY_SECRET=
ORBIT_RAZORPAY_KEY_ID=
ORBIT_RAZORPAY_KEY_SECRET=
ORBIT_RAZORPAY_WEBHOOK_SECRET=
ORBIT_RAZORPAY_INTERNATIONAL=false
# PayPal for dollar prices outside India (docs/BILLING.md): one REST app's keys, in the same mode as ORBIT_PAYPAL_ENV.
ORBIT_PAYPAL_CLIENT_ID=
ORBIT_PAYPAL_CLIENT_SECRET=
ORBIT_PAYPAL_WEBHOOK_ID=
ORBIT_PAYPAL_ENV=sandbox
ORBIT_DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
# ORBIT_DATABASE_URL=sqlite+aiosqlite:///./orbit.db   # zero-dependency local mode
ORBIT_REDIS_URL=redis://localhost:6379/0
ORBIT_JWT_SECRET=change-me-to-a-long-random-string
ORBIT_CORS_ORIGINS=["http://localhost:5173","http://localhost:1420","http://tauri.localhost","tauri://localhost"]

# LLM — server-side only. Never ship these to the desktop bundle or browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-flash

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Email (verification + password reset). Empty host = dev outbox that logs links (refused in production).
ORBIT_WEB_URL=http://localhost:5173
# Google sign-in. Leave both empty and the button stays hidden.
# Register this redirect URI in Google Cloud (local API): http://localhost:8000/v1/auth/google/callback
# Production, where the site proxies /api: https://orbitanswer.com/api/v1/auth/google/callback
ORBIT_GOOGLE_CLIENT_ID=
ORBIT_GOOGLE_CLIENT_SECRET=
# ORBIT_GOOGLE_REDIRECT_URI=
ORBIT_SMTP_HOST=
ORBIT_SMTP_PORT=587
ORBIT_SMTP_USERNAME=
ORBIT_SMTP_PASSWORD=
ORBIT_SMTP_STARTTLS=true
ORBIT_EMAIL_FROM=Orbit <no-reply@example.com>

# Desktop auto-update, option A: folder of <version>/Orbit_<version>_x64-setup.exe(+.sig).
ORBIT_DESKTOP_UPDATES_DIR=
# Option B (hosts without a persistent disk, e.g. Railway without a volume): serve the latest GitHub Release. Used when
# ORBIT_DESKTOP_UPDATES_DIR is empty. Token: fine-grained PAT, only this repo, Contents → Read-only.
# ORBIT_UPDATES_GITHUB_REPO=owner/repo
# ORBIT_UPDATES_GITHUB_TOKEN=

# Provider selection: auto | deepseek | mock   /   auto | deepgram | mock
ORBIT_LLM_PROVIDER=auto
ORBIT_STT_PROVIDER=auto

# Advanced settings (in-app admin panel).
# ORBIT_ADMIN_EMAIL: who may edit provider keys/models in the app. If unset, the first registered user is admin.
ORBIT_ADMIN_EMAIL=
# ORBIT_ALLOWED_EMAILS: who may register/sign in besides the admin — "a@x.com,@team.io", or "*" for anyone.
# Unset: open in development, admin-only in production.
# ORBIT_ALLOWED_EMAILS=
# ORBIT_CONFIG_SECRET: 32+ random chars. Required to store/rotate API keys from the app (encrypts them at rest).
# Without it, keys are read only from this file/environment and can't be edited in-app.
ORBIT_CONFIG_SECRET=

# The free, signed-out resume maker's AI: calls per rolling 24 h across everyone (0 turns it off).
# ORBIT_GUEST_RESUME_AI_DAILY=300
# Optional Business Saba network check. Requires IPinfo Plus access; no lookup without candidate consent.
ORBIT_BUSINESS_IPINFO_TOKEN=
